# bot/.env uchun namuna. Nusxa oling va qiymatni to'ldiring:
#   cp bot/.env.example bot/.env
#
# BOT_TOKEN — @BotFather dan olinadi. Bu token initData imzosini
# tekshiradi, ya'ni butun autentifikatsiyaning kaliti. Sizib chiqsa,
# istalgan odam istalgan foydalanuvchi nomidan kira oladi.
BOT_TOKEN=

# Linko katalogini kun davomida sinxronlash uchun — Vercel'dagi
# CRON_SECRET bilan BIR XIL bo'lsin. Bo'sh qoldirilsa, bot sinxronni
# chaqirmaydi (Vercel'dagi kunlik cron baribir ishlayveradi).
CRON_SECRET=

# Faqat serverda (Railway) kerak: Firebase service account JSON faylining
# TO'LIQ matni, bir qatorda. Kompyuterda bo'sh qoldiring — kalit fayldan
# o'qiladi (config.py → FIREBASE_KEY_FILE).
FIREBASE_SERVICE_ACCOUNT=

# Aqua Marin assistenti (guruhda savollarga javob). Bo'sh bo'lsa — o'chiq.
# Kalit: aistudio.google.com → Get API key (bepul tarif)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
# AI_STAFF=for_name          # javob bersa bot jim turadigan xodimlar (vergul bilan)
# AI_REPLY_DELAY=30          # xodim javobini kutish, soniya
